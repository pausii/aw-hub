# Domain yang mengarah ke IP publik server (A record). Caddy mengurus sertifikat HTTPS.
AW_HUB_DOMAIN=aw.contoh.com

# Token untuk agent di laptop. Buat dengan: openssl rand -hex 32
AW_HUB_INGEST_TOKEN=

# Login dashboard (HTTP Basic). Pakai password panjang — dashboard terbuka ke internet.
AW_HUB_DASH_USER=admin
AW_HUB_DASH_PASSWORD=

# Zona waktu & jam mulai hari (04 = pemakaian s/d jam 03:59 masuk ke hari sebelumnya)
AW_HUB_TZ=Asia/Jakarta
AW_HUB_DAY_START_HOUR=4

# Port app di host (hanya 127.0.0.1)
AW_HUB_PORT=8077
