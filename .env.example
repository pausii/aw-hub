# Domain yang mengarah ke IP publik server (A record). Caddy mengurus sertifikat HTTPS.
AW_HUB_DOMAIN=aw.contoh.com

# Token untuk agent di laptop. Buat dengan: openssl rand -hex 32
AW_HUB_INGEST_TOKEN=

# Login dashboard (halaman /login, sesi cookie 30 hari). Pakai password panjang — dashboard terbuka ke internet.
# Mengganti password otomatis mengeluarkan semua sesi yang sedang login.
AW_HUB_DASH_USER=admin
AW_HUB_DASH_PASSWORD=

# Zona waktu & jam mulai hari (04 = pemakaian s/d jam 03:59 masuk ke hari sebelumnya)
AW_HUB_TZ=Asia/Jakarta
AW_HUB_DAY_START_HOUR=4

# Port app di host (hanya 127.0.0.1)
AW_HUB_PORT=8077

# Ringkasan mingguan Telegram (opsional). Kosongkan untuk menonaktifkan.
# Bot dari @BotFather; chat id: kirim pesan ke bot lalu buka https://api.telegram.org/bot<TOKEN>/getUpdates
AW_HUB_TELEGRAM_BOT_TOKEN=
AW_HUB_TELEGRAM_CHAT_ID=
# Hari (0=Senin) & jam kirim, zona AW_HUB_TZ
AW_HUB_REPORT_WEEKDAY=0
AW_HUB_REPORT_HOUR=7
# Bahasa ringkasan Telegram: en | id
AW_HUB_REPORT_LANG=en
# URL publik untuk tautan di laporan (default https://$AW_HUB_DOMAIN)
#AW_HUB_PUBLIC_URL=
